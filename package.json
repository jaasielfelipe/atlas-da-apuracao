{
  "name": "atlas-apuracao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:contracts": "vitest run packages/tse packages/domain",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts && tsup apps/api/src/index.ts --format esm --platform node --target node22 --out-dir dist/api --external better-sqlite3",
    "start": "node dist/api/index.js",
    "backup": "node scripts/backup.mjs",
    "benchmark:national": "tsx scripts/national-benchmark.ts",
    "simulate:national": "tsx scripts/national-simulation.ts",
    "report:national": "tsx scripts/national-report.ts",
    "benchmark:local-national": "tsx scripts/national-local.ts",
    "benchmark:concurrent": "tsx scripts/national-concurrent.ts",
    "reconcile:national": "tsx scripts/national-reconciliation.ts",
    "accept:territorial-audit": "tsx scripts/accept-territorial-audit.ts",
    "collect:simulated": "tsx scripts/collect-simulated.ts",
    "observe:tse": "node scripts/observe-tse.mjs",
    "inspect:history": "tsx scripts/inspect-history.ts",
    "import:history": "tsx scripts/import-history.ts",
    "format": "prettier --write apps packages/domain/src packages/tse/src scripts tests *.ts package.json",
    "format:check": "prettier --check apps packages/domain/src packages/tse/src scripts tests *.ts package.json"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "echarts": "^6.0.0",
    "fastify": "^5.6.1",
    "maplibre-gl": "^5.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
